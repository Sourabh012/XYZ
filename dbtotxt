package spring.jpa.stream.repository;

import jakarta.persistence.QueryHint;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.jpa.repository.QueryHints;
import org.springframework.stereotype.Repository;
import spring.jpa.stream.entity.Transaction;

import java.time.LocalDateTime;
import java.util.stream.Stream;

@Repository
public interface TransactionRepository extends JpaRepository<Transaction, Long> {

    @QueryHints({
            @QueryHint(name = "org.hibernate.fetchSize", value = "1000"),
            @QueryHint(name = "org.hibernate.jdbc.fetch_direction", value = "FORWARD_ONLY") // Optional for better performance
    })
    @Query("SELECT t FROM Transaction t WHERE t.createDts BETWEEN :yesterday10PM AND :today10PM")
    Stream<Transaction> findTransactionsBetween(LocalDateTime yesterday10PM, LocalDateTime today10PM);
}



