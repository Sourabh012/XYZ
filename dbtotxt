package spring.jpa.stream.service;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import spring.jpa.stream.entity.Transaction;
import spring.jpa.stream.repository.TransactionRepository;

import java.io.*;
import java.nio.file.*;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.stream.Stream;

@Service
public class TransactionService {

    private final TransactionRepository transactionRepository;
    private static final int BATCH_SIZE = 5000;

    public TransactionService(TransactionRepository transactionRepository) {
        this.transactionRepository = transactionRepository;
    }

    @Transactional(readOnly = true)
    public String generateTransactionReport() {
        LocalDateTime today10PM = LocalDateTime.now(ZoneId.of("Asia/Kolkata")).withHour(22).withMinute(0).withSecond(0).withNano(0);
        LocalDateTime yesterday10PM = today10PM.minusDays(1);

        String fileName = "Response_" + LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyyMMdd")) + ".txt";
        Path filePath = Paths.get(fileName);

        boolean fileExists = Files.exists(filePath);

        try (Stream<Transaction> transactionStream = transactionRepository.findTransactionsBetween(yesterday10PM, today10PM);
             BufferedWriter writer = Files.newBufferedWriter(filePath, StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {

            if (transactionStream instanceof Stream) {
                System.out.println("Using JPA Stream!");
            } else {
                System.out.println("Using List!");
            }

            if (!fileExists) {
                writer.write("MQ_PAYLOAD_TXT,UNIQUE_TRNX_ID\n");
            }

            StringBuilder batchData = new StringBuilder();
            int count = 0;

            for (Transaction transaction : (Iterable<Transaction>) transactionStream::iterator) {
                batchData.append(transaction.getMqPayloadTxt())
                        .append(",")
                        .append(transaction.getUniqueTransactionId())
                        .append("\n");

                count++;

                // Process in chunks of 5000
                if (count % 5000 == 0) {
                    writer.write(batchData.toString());
                    writer.flush();
                    batchData.setLength(0);
                    System.out.println("Processed " + count + " records...");
                }
            }

            // Write any remaining records
            if (!batchData.isEmpty()) {
                writer.write(batchData.toString());
                writer.flush();
            }

            return "File generated successfully: " + filePath.toAbsolutePath();

        } catch (IOException e) {
            e.printStackTrace();
            return "Error while writing the file";
        }
    }

}

